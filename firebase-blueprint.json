        "photoURL": { "type": "string", "description": "Player avatar if authenticated" }
      }
    },
    "chat_messages": {
      "title": "Gemini Chat History",
      "description": "Multi-turn conversations with AI Sentinel and Tactical Escape Companions",
      "fields": {
        "userId": { "type": "string", "description": "User identifier" },
        "role": { "type": "string", "description": "user or model" },
        "botPersona": { "type": "string", "description": "Persona ID: sentinel, professor, hacker, or speedrunner" },
        "text": { "type": "string", "description": "Message content" },
        "timestamp": { "type": "string", "description": "Message timestamp" }
      }
    }
  }
}
